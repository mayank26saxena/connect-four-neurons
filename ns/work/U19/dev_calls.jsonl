{"call": 3, "time": "2026-11-21T16:27:23", "f1": 0.12023353402663747, "precision": 0.07379619260918253, "recall": 0.3243110236220472, "auroc": 0.5999694121448481, "sim_recovery": 0.0063173585144313815, "ceiling_recovery": 0.6115805164091681, "sim_share_of_ceiling": 0.010329561431294607, "program": "def tscore(b):\n    g = b.grid\n    s = 0\n    s += 2 * (g[1][5] == 2)\n    s += 2 * (g[0][5] == 1)\n    s += (g[0][4] == 1)\n    s += (g[0][3] == 2)\n    s += (g[0][2] == 2)\n    s += (g[1][3] == 2)\n    s -= 2 * (g[1][4] == 1)\n    return s\n\ndef fires(b):\n    return tscore(b) >= 5\n\ndef level(b):\n    s = tscore(b)\n    return max(0, min(9, 2 * (s - 3))) if s > 3 else 0\n"}
{"call": 4, "time": "2026-11-21T16:30:39", "f1": 0.2588686481303931, "precision": 0.19167061050638903, "recall": 0.3986220472440945, "auroc": 0.6736275855299598, "sim_recovery": 0.09721219536373626, "ceiling_recovery": 0.6115805164091681, "sim_share_of_ceiling": 0.15895240733715266, "program": "WO = {(0, 2): 1.0, (0, 3): 1.5, (1, 2): 1.0, (1, 3): 1.0, (1, 5): 2.0}\nWX = {(0, 4): 1.0, (0, 5): 1.5}\nPX = [(0, 1), (0, 6), (1, 2), (1, 3), (1, 4), (1, 5), (2, 2), (2, 3), (2, 4), (2, 5)]\n\ndef tscore(b):\n    g = b.grid\n    s = 0.0\n    for (r, c), w in WO.items():\n        if g[r][c] == 2:\n            s += w\n    for (r, c), w in WX.items():\n        if g[r][c] == 1:\n            s += w\n    for (r, c) in PX:\n        if g[r][c] == 1:\n            s -= 1.0\n    return s\n\ndef fires(b):\n    return tscore(b) >= 3.5\n\ndef level(b):\n    s = tscore(b)\n    if s < 2.5:\n        return 0\n    return max(0, min(9, int(round(2 * (s - 2.5)))))\n"}
{"call": 5, "time": "2026-11-21T16:31:53", "f1": 0.2273987798114254, "precision": 0.18211430263547526, "recall": 0.30265748031496065, "auroc": 0.6305624474144049, "sim_recovery": 0.10174455119416692, "ceiling_recovery": 0.6115805164091681, "sim_share_of_ceiling": 0.16636329716902945, "program": "PX = [(0, 1), (0, 6), (1, 2), (1, 3), (1, 4), (1, 5), (2, 2), (2, 3), (2, 4), (2, 5)]\n\ndef tscore(b):\n    g = b.grid\n    s = 0.0\n    # opponent stone on top of / in column 5 low\n    if g[0][5] == 1:\n        s += 1.5\n        if g[1][5] == 2:\n            s += 2.0\n    elif g[1][5] == 2:\n        s += 1.5\n    # my (0,4) stone hemmed in from the left\n    if g[0][4] == 1:\n        s += 1.0\n        s += 1.5 * (g[0][3] == 2) + 1.0 * (g[0][2] == 2) + 1.0 * (g[1][3] == 2) + 0.5 * (g[1][2] == 2)\n    elif g[0][3] == 1:\n        # my (0,3) stone flanked on both sides\n        s += 1.0 + 1.0 * (g[0][2] == 2) + 1.5 * (g[0][4] == 2)\n    for (r, c) in PX:\n        if g[r][c] == 1:\n            s -= 1.0\n    return s\n\ndef fires(b):\n    return tscore(b) >= 3.5\n\ndef level(b):\n    s = tscore(b)\n    if s < 2.5:\n        return 0\n    return max(0, min(9, int(round(1.5 * (s - 2.5)))))\n"}
