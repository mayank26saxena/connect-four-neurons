{"call": 1, "time": "2026-11-21T14:04:32", "f1": 0.10178306092124814, "precision": 0.23181049069373943, "recall": 0.06520704426463589, "auroc": 0.5291865456296762, "sim_recovery": 0.03255424249592476, "ceiling_recovery": 0.5773881105432774, "sim_share_of_ceiling": 0.05638190655726135, "program": "def score(b):\n    g = b.grid\n    s = 0.0\n    if g[0][4] == 2: s += 2\n    if g[1][4] == 2: s += 1\n    if g[0][3] == 2: s += 1\n    if g[1][3] == 2: s += 1.5\n    if g[0][2] == 1: s += 1.5\n    if g[2][2] == 1: s += 1\n    if g[0][3] == 1: s -= 1.5\n    if g[1][4] == 1: s -= 1.5\n    if g[0][4] == 1: s -= 1.5\n    s -= 0.1 * b.ply\n    s -= 0.5 * (b.heights[5] + b.heights[6] + max(0, b.heights[4] - 2))\n    return s\n\ndef fires(b):\n    return score(b) >= 3.5\n\ndef level(b):\n    v = score(b)\n    return max(0, min(9, int(round((v - 1) * 2))))\n"}
{"call": 2, "time": "2026-11-21T14:08:39", "f1": 0.1007639892628536, "precision": 0.08898614150255288, "recall": 0.11613517372679677, "auroc": 0.5392666897189069, "sim_recovery": 0.015422309711759952, "ceiling_recovery": 0.5773881105432774, "sim_share_of_ceiling": 0.026710473302349012, "program": "def score(b):\n    g = b.grid\n    s = 0\n    # opponent stones in center columns 3-4, low rows\n    for c in (3, 4):\n        for r in range(3):\n            if g[r][c] == 2:\n                s += 1\n            elif g[r][c] == 1:\n                s -= 1\n    if g[0][2] == 1:\n        s += 1\n    if b.ply > 16:\n        s -= 2\n    return s\n\ndef fires(b):\n    return score(b) >= 3\n\ndef level(b):\n    return max(0, min(9, 2 * score(b) - 2))\n"}
{"call": 3, "time": "2026-11-21T14:08:58", "f1": 0.16939746300211417, "precision": 0.11724894823486373, "recall": 0.3050928129462161, "auroc": 0.6162240967776254, "sim_recovery": 0.01653521309151207, "ceiling_recovery": 0.5773881105432774, "sim_share_of_ceiling": 0.028637952166963944, "program": "def fires(b):\n    if b.ply % 2 == 1 or b.ply < 4 or b.ply > 14:\n        return False\n    g = b.grid\n    if g[0][3] == 1:\n        return False\n    return g[0][4] == 2 or g[0][3] == 2\n\ndef level(b):\n    return 6 if fires(b) else 0\n"}
{"call": 4, "time": "2026-11-21T14:11:14", "f1": 0.17688442211055277, "precision": 0.1873336881319851, "recall": 0.16753926701570682, "auroc": 0.6603199103385686, "sim_recovery": 0.03703479944806254, "ceiling_recovery": 0.5773881105432774, "sim_share_of_ceiling": 0.0641419502268858, "program": "W = {\n    (0, 4): (-1.5, 2.0), (1, 4): (-1.0, 1.0), (0, 3): (-2.0, 1.5), (1, 3): (-1.0, 1.0),\n    (0, 2): (1.5, 0.0), (1, 2): (0.0, 1.0), (2, 2): (0.5, 0.0),\n}\n\ndef score(b):\n    g = b.grid\n    s = 0.0\n    for (r, c), (wm, wt) in W.items():\n        if g[r][c] == 1:\n            s += wm\n        elif g[r][c] == 2:\n            s += wt\n    s -= 0.5 * (b.heights[0] + b.heights[1])\n    s -= 0.15 * b.ply\n    if b.ply % 2 == 1:\n        s -= 1.0\n    return s\n\ndef fires(b):\n    v = score(b)\n    return max(0.0, min(1.0, (v + 1.0) / 6.0))\n\ndef level(b):\n    v = score(b)\n    return max(0, min(9, int(round(v * 1.5))))\n"}
{"call": 5, "time": "2026-11-21T14:11:46", "f1": 0.17985012489592006, "precision": 0.1598224195338513, "recall": 0.20561637315564016, "auroc": 0.6811430931192028, "sim_recovery": 0.03294892567496621, "ceiling_recovery": 0.5773881105432774, "sim_share_of_ceiling": 0.05706547307315322, "program": "W = {\n    (0, 4): (-1.5, 2.0), (1, 4): (-1.0, 1.0), (0, 3): (-2.0, 1.5), (1, 3): (-1.0, 1.0),\n    (0, 2): (1.5, 0.0), (1, 2): (0.0, 1.0), (2, 2): (0.5, 0.0),\n}\n\ndef score(b):\n    g = b.grid\n    s = 0.0\n    for (r, c), (wm, wt) in W.items():\n        if g[r][c] == 1:\n            s += wm\n        elif g[r][c] == 2:\n            s += wt\n    if b.last_col in (3, 4):\n        s += 1.0\n    s -= 0.4 * (b.heights[0] + b.heights[1])\n    s -= 0.12 * b.ply\n    if b.ply % 2 == 1:\n        s -= 1.0\n    return s\n\ndef fires(b):\n    v = score(b)\n    return max(0.0, min(1.0, (v + 0.5) / 6.0))\n\ndef level(b):\n    v = score(b)\n    return max(0, min(9, int(round(v * 1.5))))\n"}
